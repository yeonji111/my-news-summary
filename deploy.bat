@echo off
:: 🔥 [한글 깨짐 방지] 터미널 인코딩을 UTF-8(65001)로 강제 전환합니다.
chcp 65001

:: 1. 오늘 날짜를 YYYY-MM-DD 형식으로 자동 추출
set CURRENT_DATE=%date%

:: 2. 변경된 모든 코드 파일을 장바구니에 담기
git add .

:: 3. 자동으로 오늘 날짜를 넣어서 커밋 수행 (이제 한글이 절대 깨지지 않습니다!)
git commit -m "%CURRENT_DATE% - 경제 뉴스 요약 봇 기능 개발 및 리팩토링 완성"

:: 4. 깃허브 원격 저장소로 다이렉트 업로드
git push origin main

echo =======================================
echo 🚀 깃허브 자동 커밋 및 푸시 완료!
echo =======================================
pause